{
  "name": "class",
  "version": "1.0.0",
  "private": true,
  "description": "Student management system workspace",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @class/frontend dev",
    "dev:backend": "pnpm --filter @class/backend start:dev",
    "lint:frontend": "pnpm --filter @class/frontend lint",
    "build:frontend": "pnpm --filter @class/frontend build",
    "build:backend": "pnpm --filter @class/backend build"
  }
}
