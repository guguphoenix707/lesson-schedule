// Period 1 trial slice. Later modules: ScheduleRule, Enrollment, CreditAccount,
// CreditEntry. Do not treat those as existing tables.
generator client {
  provider     = "prisma-client"
  output       = "../backend/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  teacher
}

enum ClassSessionStatus {
  scheduled
  completed
  cancelled
}

enum TrialCaseStatus {
  pending_schedule
  scheduled
  pending_followup
  following_up
  interested
  closed
}

enum SessionKind {
  trial
}

enum BookingStatus {
  booked
  cancelled
}

enum AttendanceStatus {
  pending
  present
  absent
}

enum FollowUpOutcome {
  unreachable
  considering
  interested
  not_interested
}

enum CourseProgram {
  primary
  junior
  vce
  exam_prep
  ucat
}

enum CourseSubject {
  english
  eal
  english_language
  writing
  maths
  general_maths
  maths_methods
  specialist_maths
  science
  chemistry
  biology
  physics
  psychology
  latin
  selective_entry
  scholarship
  ucat
}

enum GuardianRelationship {
  parent
  guardian
}

enum TrialSubmittedBy {
  student
  guardian
}

enum ReferralSource {
  instagram
  facebook
  other_social
  friend_referral
  open_day
  web_search
  other
}

/// Staff login identity. Admin and teacher share one table.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  displayName   String    @map("display_name")
  role          UserRole
  /// Legacy pgcrypto hash from the SQL seed. Better Auth stores credentials in Account.
  passwordHash  String?   @map("password_hash")
  emailVerified Boolean   @default(true) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedStudents     Student[]            @relation("StudentOwner")
  defaultClasses    Class[]              @relation("ClassDefaultTeacher")
  plannedSessions   ClassSession[]       @relation("SessionPlannedTeacher")
  assignedSessions  ClassSession[]       @relation("SessionAssignedTeacher")
  authoredFollowUps FollowUp[]           @relation("FollowUpAuthor")
  sessions          Session[]
  accounts          Account[]

  @@map("users")
}

/// Student facts and current owner. Trial workflow status is on TrialCase.
model Student {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName   String   @map("display_name")
  /// Victorian year level, displayed as "Year 1" … "Year 12".
  yearLevel     String   @map("year_level")
  currentSchool String?  @map("current_school")
  email         String?
  /// Student-submitted contact. UI must mask until the card is expanded.
  phone         String?
  notes         String?
  ownerAdminId  String   @map("owner_admin_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerAdmin   User                  @relation("StudentOwner", fields: [ownerAdminId], references: [id], onDelete: Restrict)
  guardians    StudentGuardian[]
  trialCase    TrialCase?
  participants SessionParticipant[]

  @@index([ownerAdminId])
  @@map("students")
}

/// Public trial-form campus list: Box Hill, Mt Waverley, Melbourne city, Ormond, Point Cook, Adelaide, Online.
model Campus {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  nameZh    String   @map("name_zh")
  suburb    String?
  address   String?
  yearFrom  Int      @map("year_from")
  yearTo    Int      @map("year_to")
  isOnline  Boolean  @default(false) @map("is_online")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  classes    Class[]
  trialCases TrialCase[]

  @@map("campuses")
}

/// Parent or guardian contact from the public trial form (section B).
model Guardian {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName    String   @map("display_name")
  email          String
  /// Full number. UI must mask until the student card is expanded.
  phone          String
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  students StudentGuardian[]

  @@index([email])
  @@map("guardians")
}

model StudentGuardian {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  relationship GuardianRelationship @default(parent)
  isPrimary    Boolean              @default(true) @map("is_primary")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

/// Catalogue course from Austin's published programs, not a dated class.
model Course {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique
  nameEn    String        @map("name_en")
  subject   CourseSubject
  program   CourseProgram
  yearFrom  Int           @map("year_from")
  yearTo    Int           @map("year_to")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  classes    Class[]
  trialCases TrialCase[]

  @@map("courses")
}

model Class {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  campusId         String   @map("campus_id") @db.Uuid
  defaultTeacherId String   @map("default_teacher_id") @db.Uuid
  name             String   @unique
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  campus         Campus         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  defaultTeacher User           @relation("ClassDefaultTeacher", fields: [defaultTeacherId], references: [id], onDelete: Restrict)
  sessions       ClassSession[]

  @@index([courseId])
  @@index([campusId])
  @@index([defaultTeacherId])
  @@map("classes")
}

/// One dated lesson. Substitute teaching changes assignedTeacherId only.
model ClassSession {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId           String             @map("class_id") @db.Uuid
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(6)
  plannedTeacherId  String             @map("planned_teacher_id") @db.Uuid
  assignedTeacherId String             @map("assigned_teacher_id") @db.Uuid
  status            ClassSessionStatus @default(scheduled)
  cancelReason      String?            @map("cancel_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  class           Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  plannedTeacher  User                 @relation("SessionPlannedTeacher", fields: [plannedTeacherId], references: [id], onDelete: Restrict)
  assignedTeacher User                 @relation("SessionAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: Restrict)
  participants    SessionParticipant[]

  @@index([classId])
  @@index([assignedTeacherId, endsAt])
  @@map("class_sessions")
}

/// One trial workflow per student. Created at signup, before any session.
model TrialCase {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String           @unique @map("student_id") @db.Uuid
  status            TrialCaseStatus
  preferredCampusId String?          @map("preferred_campus_id") @db.Uuid
  requestedCourseId String?          @map("requested_course_id") @db.Uuid
  submittedBy       TrialSubmittedBy @default(guardian) @map("submitted_by")
  referralSource    ReferralSource?  @map("referral_source")
  concerns          String?
  nextFollowupAt    DateTime?        @map("next_followup_at") @db.Timestamptz(6)
  /// Admin communication draft. Saving it must not advance status.
  followupDraft     String?          @map("followup_draft")
  closedReason      String?          @map("closed_reason")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  preferredCampus  Campus?               @relation(fields: [preferredCampusId], references: [id], onDelete: Restrict)
  requestedCourse  Course?               @relation(fields: [requestedCourseId], references: [id], onDelete: Restrict)
  participants     SessionParticipant[]
  followUps        FollowUp[]

  @@index([status])
  @@index([preferredCampusId])
  @@index([requestedCourseId])
  @@map("trial_cases")
}

/// One student on one session roster. This period only inserts kind=trial.
model SessionParticipant {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  trialCaseId    String           @map("trial_case_id") @db.Uuid
  kind           SessionKind      @default(trial)
  bookingStatus  BookingStatus    @default(booked) @map("booking_status")
  attendance     AttendanceStatus @default(pending)
  /// present: {performance, fit_suggestion, questions_for_admin?}; absent: {absent_note?}
  teacherFeedback Json?           @map("teacher_feedback")
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?          @map("cancel_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  student   Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  trialCase TrialCase    @relation(fields: [trialCaseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([trialCaseId])
  @@map("session_participants")
}

model FollowUp {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trialCaseId    String          @map("trial_case_id") @db.Uuid
  authorAdminId  String          @map("author_admin_id") @db.Uuid
  outcome        FollowUpOutcome
  summary        String?
  nextFollowupAt DateTime?       @map("next_followup_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  trialCase   TrialCase @relation(fields: [trialCaseId], references: [id], onDelete: Restrict)
  authorAdmin User      @relation("FollowUpAuthor", fields: [authorAdminId], references: [id], onDelete: Restrict)

  @@index([trialCaseId, createdAt(sort: Desc)])
  @@map("follow_ups")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("verification")
}
