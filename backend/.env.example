# 端口 55432 对应 db/docker-compose.yml 的映射，避免和本机已有的 PostgreSQL 冲突。
# 用户名和密码只用于本地 Docker 开发库，不是生产凭据。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/class?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"
