# 端口 55432 对应 db/docker-compose.yml 的映射，避免和本机已有的 PostgreSQL 冲突。
# 用户名和密码只用于本地 Docker 开发库，不是生产凭据。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/class?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"
# Railway 同源访问时改成该服务的公开 HTTPS 地址，并同时信任平台注入的 RAILWAY_PUBLIC_DOMAIN。
# BETTER_AUTH_URL="https://example.up.railway.app"
# FRONTEND_ORIGIN="https://example.up.railway.app"
# 配置为回环地址时，会同时信任 localhost / 127.0.0.1 / [::1] 的任意端口。
# 否则 Vite 占用 5173 后改用 5174 时，登录后点退出会因 Origin 校验返回 403。

# 跟进页 AI 沟通草稿。不填时生成接口返回 503，手写草稿仍可用。不要提交真实密钥。
# 写入或修改后需重启后端进程，dotenv 只在启动时加载。
DEEPSEEK_API_KEY=""
# 可选。默认 DeepSeek Pro：deepseek-v4-pro
# DEEPSEEK_MODEL="deepseek-v4-pro"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
