{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "cd /app/backend && node scripts/wait-for-postgres.mjs && ./node_modules/.bin/prisma migrate deploy && node scripts/seed-demo-if-empty.mjs",
    "preDeployTimeoutSeconds": 300,
    "startCommand": "cd /app/backend && exec node dist/src/main.js",
    "healthcheckPath": "/api/common/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
